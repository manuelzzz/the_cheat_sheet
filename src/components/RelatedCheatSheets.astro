---
import CardLink from './CardLink.astro';

interface RelatedItem {
  href: string;
  title: string;
  description?: string;
}

interface Props {
  items: RelatedItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-12 border-t border-slate-200 pt-6 dark:border-slate-800">
      <h2 class="text-sm font-medium text-slate-900 dark:text-slate-100">
        Related Cheat Sheets
      </h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {items.map((item) => (
          <li>
            <CardLink
              href={item.href}
              title={item.title}
              description={item.description}
            />
          </li>
        ))}
      </ul>
    </section>
  )
}
