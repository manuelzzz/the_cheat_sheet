---
interface Props {
  href: string;
  title: string;
  description?: string;
}

const { href, title, description } = Astro.props;
---

<a
  href={href}
  class="block rounded-lg border border-slate-200 p-4 transition hover:border-slate-400 hover:bg-slate-50 dark:border-slate-800 dark:hover:border-slate-600 dark:hover:bg-slate-900"
>
  <span class="font-medium text-slate-900 dark:text-slate-100">{title}</span>
  {
    description && (
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">
        {description}
      </p>
    )
  }
</a>
