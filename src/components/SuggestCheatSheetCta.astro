---
const suggestUrl =
  'https://github.com/manuelzzz/the_cheat_sheet/issues/new?template=suggest-cheat-sheet.yml';
---

<div
  class="mt-10 rounded-lg border border-dashed border-slate-300 p-4 text-center"
>
  <p class="text-sm text-slate-600">Don't see what you're looking for?</p>
  <a
    href={suggestUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-2 inline-block text-sm font-medium text-slate-900 hover:underline"
  >
    Suggest a Cheat Sheet →
  </a>
</div>
