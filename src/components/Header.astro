---
import { locales } from '../config/locales';
import { withBase } from '../config/site';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
---

<header class="border-b border-slate-200">
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-4"
  >
    <a href={withBase(`/${locale}`)} class="font-semibold text-slate-900"
      >The Cheat Sheet</a
    >
    <div class="flex items-center gap-4 text-sm">
      <a
        href={withBase(`/${locale}/search`)}
        class="text-slate-500 hover:text-slate-900 hover:underline"
      >
        Search
      </a>
      <nav class="flex gap-3" aria-label="Locale">
        {
          locales.map((l) => (
            <a
              href={withBase(`/${l}`)}
              aria-current={l === locale ? 'page' : undefined}
              class={
                l === locale
                  ? 'font-semibold text-slate-900'
                  : 'text-slate-500 hover:text-slate-900 hover:underline'
              }
            >
              {l}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>
