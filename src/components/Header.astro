---
import { locales } from '../config/locales';
import { withBase } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
    <a
      href={withBase(`/${locale}`)}
      class="flex items-center gap-2 font-semibold text-slate-900 dark:text-slate-100"
    >
      <img src={withBase('/logo.svg')} alt="" class="h-7 w-7 dark:hidden" />
      <img
        src={withBase('/logo-inverse.svg')}
        alt=""
        class="hidden h-7 w-7 dark:block"
      />
      The Cheat Sheet
    </a>
    <div class="flex items-center gap-3">
      <a
        href={withBase(`/${locale}/search`)}
        class="flex items-center gap-1.5 text-sm text-slate-500 hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-slate-100"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
            clip-rule="evenodd"></path>
        </svg>
        Search
      </a>
      <div
        class="flex items-center gap-3 border-l border-slate-200 pl-3 dark:border-slate-800"
      >
        <nav class="flex gap-3 text-sm" aria-label="Locale">
          {
            locales.map((l) => (
              <a
                href={withBase(`/${l}`)}
                aria-current={l === locale ? 'page' : undefined}
                class={
                  l === locale
                    ? 'font-semibold text-slate-900 dark:text-slate-100'
                    : 'text-slate-500 hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-slate-100'
                }
              >
                {l}
              </a>
            ))
          }
        </nav>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
