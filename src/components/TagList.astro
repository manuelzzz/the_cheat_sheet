---
// Each pill also carries a `data-pagefind-filter="tag:..."` attribute, so
// Pagefind indexes tags as a facet — the search page's PagefindUI picks
// these up automatically and renders a "Tag" filter group, alongside the
// existing "Category" one.
interface Props {
  tags?: string[];
}

const { tags } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li
          data-pagefind-filter={`tag:${tag}`}
          class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400"
        >
          {tag}
        </li>
      ))}
    </ul>
  )
}
