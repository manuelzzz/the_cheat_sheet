---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { capitalize, parseCheatSheetId } from '../../../config/content';
import { githubEditUrl, withBase } from '../../../config/site';
import CopyCodeButtons from '../../../components/CopyCodeButtons.astro';
import BackToTop from '../../../components/BackToTop.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import RelatedCheatSheets from '../../../components/RelatedCheatSheets.astro';
import TagList from '../../../components/TagList.astro';
import AvailableLocales from '../../../components/AvailableLocales.astro';

export async function getStaticPaths() {
  const entries = await getCollection('cheatsheets');

  return entries.map((entry) => {
    const { locale, category, slug } = parseCheatSheetId(entry.id);
    return {
      params: { locale, category, slug },
      props: { entry, locale, category, slug },
    };
  });
}

const { entry, locale, category, slug } = Astro.props;
const { Content, headings } = await render(entry);
const editUrl = githubEditUrl(`content/${locale}/${category}/${slug}.md`);

// "Related" cheat sheets are, for now, other cheat sheets in the same
// locale and category — computed from the content collection, so a new
// cheat sheet shows up automatically without any per-page wiring.
const allEntries = await getCollection('cheatsheets');
const relatedItems = allEntries
  .map((e) => ({ ...parseCheatSheetId(e.id), entry: e }))
  .filter(
    (e) => e.locale === locale && e.category === category && e.slug !== slug,
  )
  .sort((a, b) => a.slug.localeCompare(b.slug))
  .slice(0, 4)
  .map((e) => ({
    href: withBase(`/${e.locale}/${e.category}/${e.slug}`),
    title: e.entry.data.title,
    description: e.entry.data.description,
  }));

// Locales that have this same category/slug — derived from the
// content collection, so a new translation shows up automatically.
const translations = allEntries
  .map((e) => parseCheatSheetId(e.id))
  .filter((e) => e.category === category && e.slug === slug)
  .sort((a, b) => a.locale.localeCompare(b.locale))
  .map((e) => ({
    locale: e.locale,
    href: withBase(`/${e.locale}/${category}/${slug}`),
    current: e.locale === locale,
  }));
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
>
  <div class="flex items-center justify-between gap-4">
    <a
      href={withBase(`/${locale}/${category}`)}
      class="text-sm text-slate-600 hover:underline dark:text-slate-400"
    >
      &larr; {capitalize(category)}
    </a>
    <a
      href={editUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-slate-500 hover:text-slate-900 hover:underline dark:text-slate-400 dark:hover:text-slate-100"
    >
      Edit this page
    </a>
  </div>
  <div data-pagefind-body data-pagefind-filter={`category:${category}`}>
    <h1 class="mt-2 text-3xl font-semibold">{entry.data.title}</h1>
    {
      entry.data.description && (
        <p class="mt-2 text-slate-600 dark:text-slate-400">
          {entry.data.description}
        </p>
      )
    }
    <AvailableLocales locales={translations} />
    <TagList tags={entry.data.tags} />
    <TableOfContents headings={headings} />
    <article class="prose prose-slate mt-8 max-w-none dark:prose-invert">
      <Content />
    </article>
  </div>
  <CopyCodeButtons />
  <RelatedCheatSheets items={relatedItems} />
  <BackToTop />
</Layout>
