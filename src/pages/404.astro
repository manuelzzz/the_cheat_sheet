---
import Layout from '../layouts/Layout.astro';
import SuggestCheatSheetCta from '../components/SuggestCheatSheetCta.astro';
import { defaultLocale } from '../config/locales';
import { withBase } from '../config/site';
---

<Layout title="Page not found" locale={defaultLocale}>
  <h1 class="text-2xl font-semibold">Page not found</h1>
  <p class="mt-2 text-slate-600 dark:text-slate-400">
    The page you're looking for doesn't exist, or the cheat sheet hasn't been
    written yet.
  </p>
  <a
    href={withBase(`/${defaultLocale}`)}
    class="mt-4 inline-block text-sm text-slate-900 hover:underline dark:text-slate-100"
  >
    &larr; Back to categories
  </a>
  <SuggestCheatSheetCta />
</Layout>
